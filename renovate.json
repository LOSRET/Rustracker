{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["/^tokio/"],
      "groupName": "tokio"
    },
    {
      "matchPackageNames": ["/^axum/"],
      "groupName": "axum"
    }
  ],
  "schedule": ["every weekday before 9am"]
}
